<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>UnitConversion</AssemblyName>
    <RootNamespace>UnitConversion</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- netstandard2.0 has no ArgumentNullException.ThrowIfNull -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>

    <PackageId>UnitConversion</PackageId>
    <Title>UnitConversion</Title>
    <Description>An expansible unit conversion library for .NET. Converts distance, mass, area, volume, time, temperature, speed, pressure, energy, power, angle and digital storage, with exact definitions and synonym-based unit names.</Description>
    <PackageTags>unit;units;converter;conversion;measurement;metric;imperial;temperature;distance;mass;volume;area;speed;pressure;energy;power;angle</PackageTags>
    <PackageProjectUrl>https://github.com/atulmish/UnitConversion</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/atulmish/UnitConversion/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/atulmish/UnitConversion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\Logo\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
